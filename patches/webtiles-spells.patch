+// Super Dungeon Crawl local patch: the player's memorised spells, in the cast
+// menu's (letter) order, for the client's mobile orb menu.
+struct sdc_spell_info
+{
+    string key;
+    string name;
+    int fail;
+    int mp;
+    bool usable;
+    int tile;
+    int tex;
+};
+
+static vector<sdc_spell_info> _sdc_spells()
+{
+    vector<sdc_spell_info> out;
+    for (const spell_type spell : you.spells)
+    {
+        if (spell == SPELL_NO_SPELL)
+            continue;
+        sdc_spell_info s;
+        const int letter = get_spell_letter(spell);
+        s.key = letter > 0 ? string(1, (char) letter) : string();
+        s.name = spell_title(spell);
+        s.fail = failure_rate_to_int(raw_spell_fail(spell));
+        s.mp = spell_mana(spell);
+        s.usable = you.magic_points >= s.mp
+                   && !spell_is_useless(spell, true, false);
+        const tileidx_t tile = tileidx_spell(spell);
+        s.tile = (int) tile;
+        s.tex = (int) get_tile_texture(tile);
+        out.push_back(s);
+    }
+    sort(out.begin(), out.end(),
+         [](const sdc_spell_info &a, const sdc_spell_info &b)
+         { return a.key < b.key; });
+    return out;
+}
+
+static string _sdc_spells_sig(const vector<sdc_spell_info> &spells)
+{
+    string sig;
+    for (const sdc_spell_info &s : spells)
+    {
+        sig += s.key + "|" + s.name + "|" + to_string(s.fail) + "|"
+               + to_string(s.mp) + "|" + (s.usable ? "1" : "0") + "|"
+               + to_string(s.tile) + ";";
+    }
+    return sig;
+}
+
+// Every ability in the `a` menu's order (god invocations flagged), and the
+// evocable inventory items (V + letter), for the same menu.
+struct sdc_orb_info
+{
+    string key;
+    string name;
+    int fail;
+    bool usable;
+    int tile;
+    int tex;
+    bool god;
+};
+
+static vector<sdc_orb_info> _sdc_talents()
+{
+    vector<sdc_orb_info> out;
+    for (const talent &t : your_talents(true))
+    {
+        sdc_orb_info a;
+        a.key = t.hotkey > 0 ? string(1, (char) t.hotkey) : string();
+        a.name = ability_name(t.which);
+        a.fail = failure_rate_to_int(t.fail);
+        a.usable = check_ability_possible(t.which, true);
+        const tileidx_t tile = tileidx_ability(t.which);
+        a.tile = (int) tile;
+        a.tex = (int) get_tile_texture(tile);
+        a.god = t.is_invocation;
+        out.push_back(a);
+    }
+    return out;
+}
+
+static vector<sdc_orb_info> _sdc_evokables()
+{
+    vector<sdc_orb_info> out;
+    for (int i = 0; i < ENDOFPACK; ++i)
+    {
+        const item_def &item = you.inv[i];
+        if (!item.defined() || !item_ever_evokable(item))
+            continue;
+        sdc_orb_info e;
+        e.key = string(1, index_to_letter(i));
+        e.name = item.name(DESC_PLAIN);
+        e.fail = 0;
+        e.usable = cannot_evoke_item_reason(&item, true, true).empty();
+        const tileidx_t tile = tileidx_item(item);
+        e.tile = (int) tile;
+        e.tex = (int) get_tile_texture(tile);
+        e.god = false;
+        out.push_back(e);
+    }
+    return out;
+}
+
+static string _sdc_orb_sig(const vector<sdc_orb_info> &list)
+{
+    string sig;
+    for (const sdc_orb_info &o : list)
+    {
+        sig += o.key + "|" + o.name + "|" + to_string(o.fail) + "|"
+               + (o.usable ? "1" : "0") + "|" + to_string(o.tile) + "|"
+               + (o.god ? "1" : "0") + ";";
+    }
+    return sig;
+}
+
+static void _sdc_send_orb_list(const char *name,
+                               const vector<sdc_orb_info> &list)
+{
+    tiles.json_open_array(name);
+    for (const sdc_orb_info &o : list)
+    {
+        tiles.json_open_object();
+        tiles.json_write_string("key", o.key);
+        tiles.json_write_string("name", o.name);
+        tiles.json_write_int("fail", o.fail);
+        tiles.json_write_bool("usable", o.usable);
+        tiles.json_write_int("tile", o.tile);
+        tiles.json_write_int("tex", o.tex);
+        tiles.json_write_bool("god", o.god);
+        tiles.json_close_object();
+    }
+    tiles.json_close_array();
+}
+
 static bool _update_statuses(player_info& c)
