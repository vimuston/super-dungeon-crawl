+    {
+        const vector<sdc_spell_info> spells = _sdc_spells();
+        const string sig = _sdc_spells_sig(spells);
+        if (force_full || c.spells_sig != sig)
+        {
+            json_open_array("spells");
+            for (const sdc_spell_info &s : spells)
+            {
+                json_open_object();
+                json_write_string("key", s.key);
+                json_write_string("name", s.name);
+                json_write_int("fail", s.fail);
+                json_write_int("mp", s.mp);
+                json_write_bool("usable", s.usable);
+                json_write_int("tile", s.tile);
+                json_write_int("tex", s.tex);
+                json_close_object();
+            }
+            json_close_array();
+            c.spells_sig = sig;
+        }
+    }
+    {
+        const vector<sdc_orb_info> talents = _sdc_talents();
+        const string sig = _sdc_orb_sig(talents);
+        if (force_full || c.talents_sig != sig)
+        {
+            _sdc_send_orb_list("talents", talents);
+            c.talents_sig = sig;
+        }
+    }
+    {
+        const vector<sdc_orb_info> evok = _sdc_evokables();
+        const string sig = _sdc_orb_sig(evok);
+        if (force_full || c.evokables_sig != sig)
+        {
+            _sdc_send_orb_list("evokables", evok);
+            c.evokables_sig = sig;
+        }
+    }
+
     if (m_origin.equals(-1, -1))
         m_origin = you.position;
     coord_def pos = you.position - m_origin;
